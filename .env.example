# ---- Site URL (SEO) ----
# Public origin used for canonical URLs, sitemap, robots, and structured data.
# Set this to your production domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# ---- Analytics (optional) ----
# Cloudflare Web Analytics beacon token. The beacon is only loaded in
# production and is never loaded on /resume.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# ---- AI (optional) ----
# Feature flag gating server AI routes. Routes fail closed when unset/false.
AI_ENABLED=false
# OpenAI-compatible API key (server-only; never use NEXT_PUBLIC_)
OPENAI_API_KEY=
# Base URL override for OpenAI-compatible providers (default: https://api.openai.com/v1)
OPENAI_BASE_URL=
# Model identifier (default: gpt-4o-mini)
OPENAI_MODEL=

# ---- Global rate limiting (optional, recommended for production AI) ----
# Vercel KV (Upstash Redis REST API) credentials. When both are set, AI routes
# enforce a global 20 req/min limit across all serverless instances; without
# them, a per-instance in-memory limiter is used (best effort).
KV_REST_API_URL=
KV_REST_API_TOKEN=
